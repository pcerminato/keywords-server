{
  "name": "keywords-server",
  "version": "1.0.0",
  "description": "Restful service for sentiment anylisis",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "build": "rm -rf ./dist && tsc",
    "dev": "node --env-file=.env  --import ./registry/ts-node-esm.js --watch-path=src src/server.ts",
    "start": "node dist/server.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint",
    "docker:build": "docker build --target development -t keywords-server:latest .",
    "docker:run": "docker run -p 8080:8080 --name keywords-server:latest -d keywords-server:latest",
    "docker:compose": "docker compose up -d --build",
    "docker:stop": "docker stop $(docker ps -q)"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pcerminato/keywords-server.git"
  },
  "author": "pcerminato@gmail.com",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/pcerminato/keywords-server/issues"
  },
  "homepage": "https://github.com/pcerminato/keywords-server#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "@types/supertest": "^7.2.0",
    "eslint": "^10.1.0",
    "jest": "^30.3.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "~5.7.0",
    "typescript-eslint": "^8.57.2"
  },
  "dependencies": {
    "@google/genai": "^1.50.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.1.1",
    "serverless-http": "^4.0.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1"
  }
}
